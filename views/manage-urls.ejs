<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage URLs - URL Shortener</title>
    <link rel="stylesheet" href="/styles/variables.css">
    <link rel="stylesheet" href="/styles/globals.css">
    <link rel="stylesheet" href="/styles/components.css">
    <link rel="stylesheet" href="/styles/manage.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="page-body">
    <div class="management-container">
        <div class="header">
            <h1>📊 Manage URLs</h1>
            <a href="/" class="back-btn">← Back to Home</a>
        </div>

        <div class="stats">
            <div class="stat-card">
                <div class="stat-number">
                    <%= urls.length %>
                </div>
                <div class="stat-label">Total URLs</div>
            </div>
            <% if (!locals.user) { %>
                <div class="guest-banner">
                    <span>⚠️ Guest Mode: URLs expire in 1 hour. <a href="/signup">Sign up</a> to save them
                        permanently!</span>
                </div>
                <% } %>
        </div>

        <% if (urls.length> 0) { %>
            <table class="urls-table">
                <thead>
                    <tr>
                        <th>Short ID</th>
                        <th>Original URL</th>
                        <th>Total Clicks</th>
                        <th>Expires At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% urls.forEach((url, index)=> { %>
                        <tr>
                            <td data-label="Short ID">
                                <span class="short-id">
                                    <%= url.shortId %>
                                </span>
                            </td>
                            <td data-label="Original URL">
                                <div class="redirect-url">
                                    <%= url.redirectUrl %>
                                </div>
                            </td>
                            <td data-label="Total Clicks">
                                <div class="analytics">
                                    <%= url.clickCount %>
                                </div>
                            </td>
                            <td data-label="Expires At">
                                <div class="expiry-date">
                                    <%= url.expiresAt ? new Date(url.expiresAt).toLocaleString() : 'Never' %>
                                </div>
                            </td>
                            <td data-label="Actions">
                                <div class="action-buttons">
                                    <button class="btn-copy" onclick="copyShortId('<%= url.shortId %>', this)">
                                        📋 Copy
                                    </button>
                                    <button class="btn-delete" onclick="deleteUrl('<%= url.shortId %>')">
                                        🗑️ Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
            <% } else { %>
                <div class="empty-state">
                    <p>No URLs created yet</p>
                    <a href="/" class="empty-link">Create your first URL →</a>
                </div>
                <% } %>
    </div>

    <script>
        function copyShortId(shortId, button) {
            const fullUrl = `<%= baseUrl %>/${shortId}`;
            const originalText = button.innerText;

            navigator.clipboard.writeText(fullUrl)
                .then(() => {
                    button.innerText = '✓';
                    button.classList.add('copied');

                    setTimeout(() => {
                        button.innerText = originalText;
                        button.classList.remove('copied');
                    }, 2000);
                })
                .catch(() => {
                    button.innerText = '❌ Failed';
                    setTimeout(() => {
                        button.innerText = originalText;
                    }, 2000);
                });
        }

        function deleteUrl(shortId) {
            if (confirm('Are you sure you want to delete this URL?')) {
                fetch(`/api/v1/url/${shortId}`, {
                    method: 'DELETE'
                })
                    .then(response => response.json())
                    .then(data => {
                        location.reload();
                    })
                    .catch(error => {
                        alert('Error deleting URL: ' + error);
                    });
            }
        }
    </script>
</body>

</html>